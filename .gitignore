# ── Secrets — never commit (contains the DB password) ────────────────────────
GRASP_System/config/website_config.ini

# ── macOS / editor junk ──────────────────────────────────────────────────────
.DS_Store

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]

# ── Virtual environments (regenerate locally) ────────────────────────────────
myenv/
.venv/
venv/

# ── Generated / processed data — kept local, not on GitHub ───────────────────
# The 1.3 GB source media library lives outside the repo at ~/GRASP_media.
# These are pipeline outputs written into the GRASP_System area:
GRASP_System/media/
GRASP_System/special_images/
GRASP_System/gedcoms/
GRASP_System/styles/
GRASP_System/assets/

# ── Generated website output (rebuilt by generate_website.py) ────────────────
# Copied media (~1.3 GB) and thumbnails — never to GitHub:
website/images/
website/thumbnails/
# Generated HTML pages (regenerable; placeholders keep the folder structure):
website/*.html
website/**/*.html
